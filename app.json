{
  "expo": {
    "name": "Solace",
    "slug": "solace-wellness",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "solace",
    "android": {
      "package": "com.solacewellness.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/solace-android-foreground.png",
        "backgroundColor": "#FAEFE2",
        "monochromeImage": "./assets/app-icons/solace-android-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "./scripts/with-realtime-android.cjs",
      "./scripts/with-android-launch.cjs",
      ["expo-notifications", { "enableRemoteNotifications": false }],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Solace to use Face ID to unlock your saved sign-in or private journal."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Solace to use Face ID to unlock your saved sign-in or private journal."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your Solace account.",
          "cameraPermission": false,
          "microphonePermission": "Allow Solace to use the microphone for a live voice conversation or to record a voice message for transcription.",
          "colors": {
            "cropToolbarColor": "#FBF0E8",
            "cropToolbarIconColor": "#183A2B",
            "cropBackgroundColor": "#FBF0E8"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#111112",
              "cropToolbarIconColor": "#F5F0E8",
              "cropBackgroundColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Solace to use the microphone for a live voice conversation or to record a voice message for transcription.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/app-icons/solace-light.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.solacewellness.app",
      "icon": {
        "light": "./assets/app-icons/solace-light.png",
        "dark": "./assets/app-icons/solace-ios-dark.png",
        "tinted": "./assets/app-icons/solace-tinted.png"
      }
    }
  }
}
