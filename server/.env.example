PORT=3001
HOST=0.0.0.0
# Keep 0 unless the exact number of controlled reverse-proxy hops is known (0..3).
# Incorrect trust permits spoofed client IPs and weakens per-IP rate limits.
TRUST_PROXY_HOPS=0
DATABASE_PATH=./data/solace.sqlite
# Gemini is the primary text provider when configured. Keep keys server-side.
# Use a billing-enabled Gemini project for personal or sensitive conversations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI is the text provider when no Gemini key is set and still handles voice.
# Opt in to sending requests to OpenAI when Gemini has a transient failure.
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional override for turn-based voice transcription; requires provider access.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
# offline = built-in companion only; auto = live when a key is set; live = require a key
AI_MODE=auto
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:19006
# Required before publishing a network-accessible production deployment.
NODE_ENV=development
