PORT=3001
HOST=0.0.0.0
# Keep 0 unless the exact number of controlled reverse-proxy hops is known (0..3).
# Incorrect trust permits spoofed client IPs and weakens per-IP rate limits.
TRUST_PROXY_HOPS=0
DATABASE_PATH=./data/solace.sqlite
# Configure a paid/provider key locally. Never put it in EXPO_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# offline = deterministic companion only; auto = live when key supplied; live = require valid key
AI_MODE=auto
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:19006
# Required before publishing a network-accessible production deployment.
NODE_ENV=development
