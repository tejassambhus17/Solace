PORT=3001
HOST=0.0.0.0
# Keep 0 unless the exact number of controlled reverse-proxy hops is known (0..3).
# Incorrect trust permits spoofed client IPs and weakens per-IP rate limits.
TRUST_PROXY_HOPS=0
DATABASE_PATH=./data/solace.sqlite
# OpenAI is the only live AI provider. Keep the project key server-side.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-terra
OPENAI_LIGHT_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Audio Speech model. OpenAI currently schedules this model for removal on 2027-01-06.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Live Voice Talk uses an authenticated, server-controlled WebRTC session.
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
REALTIME_SESSION_SECONDS=300
REALTIME_DAILY_SECONDS=900
REALTIME_GLOBAL_DAILY_SECONDS=3600
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional content-free aggregate token counts and estimated text cost.
OPENAI_USAGE_LOG=false
# offline = built-in companion only; auto = live when a key is set; live = require a key
AI_MODE=auto
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:19006
# Optional Google OpenID Connect Web application client. Keep the secret server-side.
# Use an HTTPS redirect registered with Google ending in /api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Optional password recovery through authenticated TLS SMTP. Keep credentials private.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required before publishing a network-accessible production deployment.
NODE_ENV=development
