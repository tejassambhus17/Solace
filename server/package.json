{
  "name": "@solace/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "pretest:process": "tsc -p tsconfig.json",
    "test:process": "tsx --test tests/startup.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "sharp": "^0.35.5",
    "sql.js": "^1.13.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
