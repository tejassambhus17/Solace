{
  "name": "solace-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "node scripts/runtime.cjs dev",
    "server": "node scripts/runtime.cjs server",
    "start": "node scripts/runtime.cjs expo start",
    "web": "node scripts/runtime.cjs expo start --web",
    "android": "node scripts/runtime.cjs expo start --android",
    "typecheck": "node scripts/runtime.cjs tsc --noEmit",
    "test:wellness": "node scripts/runtime.cjs wellness",
    "test:reminders": "node scripts/runtime.cjs reminders",
    "test:session-state": "node scripts/runtime.cjs session-state",
    "export:web": "node scripts/runtime.cjs expo export --platform web --output-dir dist/web",
    "export:android": "node scripts/runtime.cjs expo export --platform android --output-dir dist/android",
    "export:ios": "node scripts/runtime.cjs expo export --platform ios --output-dir dist/ios",
    "preview": "node scripts/preview.mjs",
    "format:check": "prettier --check App.tsx index.ts \"src/**/*.{ts,tsx}\" \"server/src/*.ts\" \"server/tests/*.ts\"",
    "test:insights": "node scripts/runtime.cjs insights",
    "test:routine": "node scripts/runtime.cjs routine",
    "test:offline": "node scripts/runtime.cjs offline",
    "setup": "node scripts/runtime.cjs setup",
    "doctor": "node scripts/runtime.cjs doctor",
    "test:tooling": "node scripts/runtime.cjs tooling",
    "test:api-config": "node scripts/runtime.cjs api-config",
    "server:typecheck": "node scripts/runtime.cjs npm --prefix server run typecheck",
    "server:test": "node scripts/runtime.cjs npm --prefix server test",
    "server:build": "node scripts/runtime.cjs npm --prefix server run build",
    "export:web:preview": "node scripts/runtime.cjs expo export --platform web --dev --output-dir dist/web",
    "ios": "node scripts/runtime.cjs expo run:ios",
    "test:voice": "node scripts/runtime.cjs voice",
    "test:progress": "node scripts/runtime.cjs progress",
    "test:moments": "node scripts/runtime.cjs moments",
    "test:native-config": "node scripts/runtime.cjs native-config"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
